@page "/mood"
@using MoodLog.Core.Models
@using MoodLog.Core.Services
@inject MoodJournalService Journal
@inject IJSRuntime JS
@inject ILogger<MoodJournal> Logger

<PageTitle>Mood journal | MoodLog</PageTitle>

<main class="mood-page">
    <header class="mood-header">
        <div>
            <p class="mood-eyebrow">YOUR PERSONAL WELLNESS SPACE</p>
            <h1>Mood journal</h1>
            <p class="mood-subtitle">A small check-in can help you notice how you feel over time.</p>
        </div>
        <span class="mood-date">@DateTime.Today.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)</span>
    </header>

    <div class="mood-grid">
        <section class="mood-card mood-form-card">
            <h2>How are you feeling?</h2>
            <p class="mood-muted">Take a moment to check in with yourself.</p>

            <EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" FormName="mood-journal">
                <DataAnnotationsValidator />
                <label class="form-label" for="entry-date">Date</label>
                <InputDate id="entry-date" class="form-control mood-control" @bind-Value="_form.Date" />
                <ValidationMessage For="@(() => _form.Date)" />

                <label class="form-label mt-3" for="entry-level">Mood</label>
                <InputSelect id="entry-level" class="form-select mood-control" @bind-Value="_form.Level">
                    @foreach (var level in Enum.GetValues<MoodLevel>())
                    {
                        <option value="@level">@level.ToEmoji() @level.ToLabel()</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _form.Level)" />

                <label class="form-label mt-3" for="entry-tags">Tags <span class="mood-muted">(optional)</span></label>
                <InputText id="entry-tags" class="form-control mood-control" @bind-Value="_form.Tags"
                           placeholder="work, friends, rest" />
                <div class="mood-help">Up to 10 tags; each may contain up to 40 characters.</div>

                <label class="form-label mt-3" for="entry-note">Note <span class="mood-muted">(optional)</span></label>
                <InputTextArea id="entry-note" class="form-control mood-control" @bind-Value="_form.Note"
                               maxlength="500" rows="4" placeholder="What would you like to remember?" />
                <ValidationMessage For="@(() => _form.Note)" />
                <div class="mood-help">Up to 500 characters</div>

                <div class="form-actions mt-4">
                    <button class="btn mood-submit" type="submit" disabled="@_saving">@(_editingId is null ? "Save check-in" : "Save changes")</button>
                    @if (_editingId is not null)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
                    }
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <p class="@(_isError ? "tracker-error" : "mood-feedback")" role="status">@_message</p>
            }
        </section>

        <section class="mood-card mood-history-card">
            <div class="mood-history-heading">
                <div>
                    <h2>Recent check-ins</h2>
                    <p class="mood-muted">Your latest moments, in one place.</p>
                </div>
                <span class="mood-count">@_entries.Count</span>
            </div>

            @if (_entries.Count == 0)
            {
                <div class="mood-empty">
                    <p>Your journal starts here.</p>
                    <p class="mood-muted">Add your first check-in to see it in your history.</p>
                </div>
            }
            else
            {
                <div class="mood-entry-list">
                    @foreach (var entry in _entries)
                    {
                        <article class="mood-entry">
                            <span class="mood-entry-emoji" aria-hidden="true">@entry.Level.ToEmoji()</span>
                            <div class="mood-entry-content">
                                <div class="mood-entry-heading">
                                    <strong>@entry.Level.ToLabel()</strong>
                                    <time datetime="@entry.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@entry.Date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</time>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Note))
                                {
                                    <p class="mood-entry-note">@entry.Note</p>
                                }
                                @if (entry.Tags.Count > 0)
                                {
                                    <div class="mood-tags">
                                        @foreach (var tag in entry.Tags)
                                        {
                                            <span>@tag</span>
                                        }
                                    </div>
                                }
                                <EntryActions Label="mood entry" Busy="_saving"
                                              OnEdit="() => EditEntry(entry)"
                                              OnDelete="() => DeleteAsync(entry.Id)" />
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</main>

@code {
    private MoodEntryForm _form = new();
    private IReadOnlyList<MoodEntry> _entries = [];
    private Guid? _editingId;
    private string? _message;
    private bool _isError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _form.Date = DateOnly.FromDateTime(DateTime.Today);
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        try { _entries = await Journal.GetRecentAsync(30); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load mood history");
            _isError = true;
            _message = "Could not load your check-ins. Please refresh the page.";
        }
    }

    private void EditEntry(MoodEntry entry)
    {
        _editingId = entry.Id;
        _form = new MoodEntryForm
        {
            Date = entry.Date, Level = entry.Level,
            Tags = string.Join(", ", entry.Tags), Note = entry.Note
        };
        _message = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new MoodEntryForm { Date = DateOnly.FromDateTime(DateTime.Today) };
        _message = null;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var tags = _form.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var result = _editingId is Guid id
                ? await Journal.UpdateAsync(id, _form.Date, _form.Level, tags, _form.Note)
                : await Journal.AddAsync(_form.Date, _form.Level, tags, _form.Note);
            _isError = result.IsFailure;
            if (_isError) { _message = result.Error.Message; return; }

            var edited = _editingId is not null;
            CancelEdit();
            await LoadEntriesAsync();
            if (!_isError) _message = edited ? "Your check-in has been updated." : "Your check-in has been saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save mood entry");
            _isError = true;
            _message = "Could not save your check-in. Please try again.";
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_saving) return;
        try
        {
            // JS interop can fail if the browser disconnects; keep it inside try/catch.
            if (!await JS.InvokeAsync<bool>("confirm", "Delete this check-in? This cannot be undone.")) return;
            _saving = true;
            var result = await Journal.DeleteAsync(id);
            _isError = result.IsFailure;
            _message = _isError ? result.Error.Message : "Check-in deleted.";
            if (!_isError)
            {
                if (_editingId == id) CancelEdit();
                await LoadEntriesAsync();
                if (!_isError) _message = "Check-in deleted.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to delete mood entry");
            _isError = true;
            _message = "Could not delete the check-in. Please try again.";
        }
        finally { _saving = false; }
    }

    private sealed class MoodEntryForm
    {
        [Required]
        public DateOnly Date { get; set; }

        [EnumDataType(typeof(MoodLevel))]
        public MoodLevel Level { get; set; } = MoodLevel.Neutral;

        public string Tags { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Note cannot exceed 500 characters.")]
        public string Note { get; set; } = string.Empty;
    }
}
