@page "/"
@using MoodLog.Core.Models
@using MoodLog.Core.Services
@inject WellnessAnalyticsService Analytics
@inject ProfileSettingsService ProfileService

<PageTitle>Dashboard | MoodLog</PageTitle>

<main class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <p class="dashboard-eyebrow">YOUR WELLNESS, AT A GLANCE</p>
            <h1>Good @Greeting, @_displayName</h1>
            <p class="dashboard-subtitle">A little progress is still progress. Here's your day so far.</p>
        </div>
        <span class="dashboard-date">@DateTime.Today.ToString("dddd, MMMM d")</span>
    </header>

    <section class="dashboard-metrics" aria-label="Today's wellness summary">
        <a class="dashboard-metric metric-mood" href="mood">
            <span class="metric-icon" aria-hidden="true">@(Today?.AverageMood is double mood ? MoodLevelExtensions.ToEmoji((MoodLevel)Math.Clamp((int)Math.Round(mood), 1, 5)) : "☺")</span>
            <span class="metric-label">Mood</span>
            <strong>@(Today?.AverageMood is double averageMood ? $"{averageMood:F1} / 5" : "Not logged")</strong>
            <span class="metric-link">Check in <span aria-hidden="true">→</span></span>
        </a>
        <a class="dashboard-metric metric-water" href="water">
            <span class="metric-icon" aria-hidden="true">💧</span>
            <span class="metric-label">Water</span>
            <strong>@(Today?.WaterConsumedMl ?? 0) <small>/ @DailyWaterGoal.ToString("N0") ml</small></strong>
            <span class="metric-link">Log water <span aria-hidden="true">→</span></span>
        </a>
        <a class="dashboard-metric metric-sleep" href="sleep">
            <span class="metric-icon" aria-hidden="true">🌙</span>
            <span class="metric-label">Sleep</span>
            <strong>@FormatDuration(Today?.SleepMinutes)</strong>
            <small class="metric-goal">Goal: @(_profile.DailySleepGoalMinutes / 60) hours</small>
            <span class="metric-link">Log sleep <span aria-hidden="true">→</span></span>
        </a>
        <a class="dashboard-metric metric-activity" href="activity">
            <span class="metric-icon" aria-hidden="true">🏃</span>
            <span class="metric-label">Activity</span>
            <strong>@((Today?.Steps ?? 0).ToString("N0")) <small>/ @_profile.DailyStepGoal.ToString("N0") steps</small></strong>
            <small class="metric-goal">@(Today?.ActivityMinutes ?? 0) active minutes</small>
            <span class="metric-link">Log activity <span aria-hidden="true">→</span></span>
        </a>
    </section>

    <div class="dashboard-lower">
        <section class="dashboard-card insights-card">
            <div class="dashboard-card-heading">
                <div>
                    <p class="dashboard-eyebrow">GENTLE OBSERVATIONS</p>
                    <h2>Patterns, not pressure</h2>
                </div>
                <span aria-hidden="true">✦</span>
            </div>
            <ul class="dashboard-insights">
                @foreach (var insight in _report?.Insights ?? [])
                {
                    <li>@insight</li>
                }
            </ul>
            <p class="dashboard-disclaimer">Based only on what you've logged. These are not medical advice or diagnoses.</p>
            <a class="dashboard-text-link" href="analytics">Explore your analytics →</a>
        </section>

        <section class="dashboard-card dashboard-quick-card">
            <p class="dashboard-eyebrow">DAILY CHECK-IN</p>
            <h2>Make today count</h2>
            <p class="dashboard-subtitle">Your personal log is ready whenever you are.</p>
            <div class="dashboard-actions">
                <a href="mood">😊 <span>Log mood</span></a>
                <a href="water">💧 <span>Add water</span></a>
                <a href="sleep">🌙 <span>Track sleep</span></a>
                <a href="activity">🏃 <span>Log activity</span></a>
            </div>
        </section>
    </div>
</main>

@code {
    private WellnessReport? _report;
    private ProfileSettings _profile = ProfileSettings.Default;
    private string _displayName => _profile.DisplayName;
    private WellnessDay? Today => _report?.Days.SingleOrDefault();
    private int DailyWaterGoal =>
        Today is { WaterConsumedMl: > 0 } day ? day.WaterGoalMl : _profile.DailyWaterGoalMl;
    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "morning",
        < 18 => "afternoon",
        _ => "evening"
    };

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetAsync();
        _report = await Analytics.GetReportAsync(DateOnly.FromDateTime(DateTime.Today), 1);
    }

    private static string FormatDuration(int? minutes) =>
        minutes is null ? "Not logged" : $"{minutes.Value / 60}h {minutes.Value % 60:D2}m";
}
