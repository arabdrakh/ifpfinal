@page "/activity"
@using MoodLog.Core.Models
@using MoodLog.Core.Services
@inject ActivityTrackerService ActivityService
@inject IJSRuntime JS
@inject ILogger<ActivityTracker> Logger

<PageTitle>Activity tracker | MoodLog</PageTitle>

<main class="tracker-page">
    <header class="tracker-header">
        <div>
            <p class="tracker-eyebrow">MOVEMENT & MOMENTUM</p>
            <h1>Activity tracker</h1>
            <p class="tracker-subtitle">Celebrate movement in a way that works for you.</p>
        </div>
        <label class="tracker-date-label" for="activity-date">
            <span>Activity date</span>
            <InputDate id="activity-date" class="form-control tracker-control"
                       @bind-Value="_date" @bind-Value:after="ChangeDateAsync" />
        </label>
    </header>

    <div class="tracker-columns">
        <section class="tracker-card" aria-labelledby="activity-form-title">
            <h2 id="activity-form-title">Log an activity</h2>
            <p class="tracker-muted">Record a workout, walk, or any movement.</p>

            <EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" FormName="activity-tracker">
                <DataAnnotationsValidator />
                <label class="form-label" for="activity-type">Activity</label>
                <InputSelect id="activity-type" class="form-select tracker-control" @bind-Value="_form.Type">
                    @foreach (var type in Enum.GetValues<ActivityType>())
                    {
                        <option value="@type">@FormatType(type)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _form.Type)" />

                <label class="form-label mt-3" for="activity-duration">Duration</label>
                <div class="input-group">
                    <InputNumber id="activity-duration" class="form-control tracker-control"
                                 @bind-Value="_form.DurationMinutes" min="1" max="1440" />
                    <span class="input-group-text tracker-unit">minutes</span>
                </div>
                <ValidationMessage For="@(() => _form.DurationMinutes)" />

                <label class="form-label mt-3" for="activity-steps">Steps <span class="tracker-muted">(optional)</span></label>
                <InputNumber id="activity-steps" class="form-control tracker-control"
                             @bind-Value="_form.Steps" min="0" max="100000" />
                <ValidationMessage For="@(() => _form.Steps)" />
                <p class="tracker-hint">Duration: 1–1440 minutes · Steps: up to 100000</p>

                <div class="form-actions mt-3">
                    <button class="btn tracker-submit" type="submit" disabled="@_saving">@(_editingId is null ? "Save activity" : "Save changes")</button>
                    @if (_editingId is not null)
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
                    }
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <p class="@(_isError ? "tracker-error" : "tracker-feedback")" role="status">@_message</p>
            }
        </section>

        <section class="tracker-card" aria-labelledby="activity-summary-title">
            <div class="tracker-section-heading">
                <div>
                    <h2 id="activity-summary-title">@(_date == DateOnly.FromDateTime(DateTime.Today) ? "Today's movement" : "Selected day's movement")</h2>
                    <p class="tracker-muted">@_date.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</p>
                </div>
                <span class="tracker-count">@_entries.Count</span>
            </div>

            <div class="activity-summary">
                <div><strong>@_totalMinutes</strong><span>active minutes</span></div>
                <div><strong>@_totalSteps.ToString("N0")</strong><span>steps</span></div>
            </div>

            @if (_entries.Count == 0)
            {
                <p class="tracker-empty">Your activities will appear here.</p>
            }
            else
            {
                <ul class="tracker-list">
                    @foreach (var entry in _entries)
                    {
                        <li>
                            <span class="tracker-icon" aria-hidden="true">@GetIcon(entry.Type)</span>
                            <div class="tracker-list-main">
                                <strong>@FormatType(entry.Type)</strong>
                                <span>@entry.DurationMinutes min · @entry.Steps.ToString("N0") steps</span>
                            </div>
                            <time datetime="@entry.LoggedAt.ToString("O")">@entry.LoggedAt.ToLocalTime().ToString("h:mm tt")</time>
                            <EntryActions Label="activity entry" Busy="_saving"
                                              OnEdit="() => EditEntry(entry)"
                                              OnDelete="() => DeleteAsync(entry.Id)" />
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</main>

@code {
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<ActivityLog> _entries = [];
    private ActivityForm _form = new();
    private Guid? _editingId;
    private string? _message;
    private bool _isError;
    private bool _saving;

    private int _totalMinutes => _entries.Sum(entry => entry.DurationMinutes);
    private long _totalSteps => _entries.Sum(entry => (long)entry.Steps);

    protected override Task OnInitializedAsync() => LoadEntriesAsync();

    private void EditEntry(ActivityLog entry)
    {
        _editingId = entry.Id;
        _form = new ActivityForm
        {
            Type = entry.Type,
            DurationMinutes = entry.DurationMinutes,
            Steps = entry.Steps
        };
        _message = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form = new ActivityForm();
        _message = null;
    }

    private async Task ChangeDateAsync()
    {
        CancelEdit();
        await LoadEntriesAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var result = _editingId is Guid id
                ? await ActivityService.UpdateAsync(id, _date, _form.Type, _form.DurationMinutes, _form.Steps)
                : await ActivityService.AddAsync(_date, _form.Type, _form.DurationMinutes, _form.Steps);
            _isError = result.IsFailure;
            if (_isError) { _message = result.Error.Message; return; }

            var edited = _editingId is not null;
            CancelEdit();
            await LoadEntriesAsync();
            if (!_isError) _message = edited ? "Activity updated." : "Activity saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save activity entry");
            _isError = true;
            _message = "Could not save activity. Please try again.";
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_saving) return;
        try
        {
            // JS interop can fail if the browser disconnects; keep it inside try/catch.
            if (!await JS.InvokeAsync<bool>("confirm", "Delete this activity? This cannot be undone.")) return;
            _saving = true;
            var result = await ActivityService.DeleteAsync(id);
            _isError = result.IsFailure;
            _message = _isError ? result.Error.Message : "Activity deleted.";
            if (!_isError)
            {
                if (_editingId == id) CancelEdit();
                await LoadEntriesAsync();
                if (!_isError) _message = "Activity deleted.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to delete activity entry");
            _isError = true;
            _message = "Could not delete activity. Please try again.";
        }
        finally { _saving = false; }
    }

    private async Task LoadEntriesAsync()
    {
        try
        {
            _entries = await ActivityService.GetForDateAsync(_date);
            _isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load activity history");
            _isError = true;
            _message = "Could not load activity history. Please refresh the page.";
        }
    }

    private static string FormatType(ActivityType type) =>
        type == ActivityType.Other ? "Other activity" : type.ToString();

    private static string GetIcon(ActivityType type) => type switch
    {
        ActivityType.Walking => "🚶",
        ActivityType.Running => "🏃",
        ActivityType.Cycling => "🚴",
        ActivityType.Workout => "💪",
        _ => "✨"
    };

    private sealed class ActivityForm
    {
        [EnumDataType(typeof(ActivityType))]
        public ActivityType Type { get; set; } = ActivityType.Walking;

        [Range(1, 1440, ErrorMessage = "Duration must be between 1 and 1440 minutes.")]
        public int DurationMinutes { get; set; } = 30;

        [Range(0, 100000, ErrorMessage = "Steps must be between 0 and 100000.")]
        public int Steps { get; set; }
    }
}
