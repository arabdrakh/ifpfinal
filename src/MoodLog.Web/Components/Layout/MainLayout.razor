@inherits LayoutComponentBase

<div class="page" data-interactive="@_interactiveReady.ToString().ToLowerInvariant()">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="page-content content px-4">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // OnAfterRender is not called during static prerendering. Browser tests can
    // wait for this marker rather than submit forms before the circuit connects.
    private bool _interactiveReady;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _interactiveReady = true;
        StateHasChanged();
    }
}
